{
  "$schema": "https://typedoc.org/schema.json",

  "entryPoints": ["packages/core", "packages/geometry", "packages/three", "packages/xml"],
  "entryPointStrategy": "packages",
  "packageOptions": {
    "includeVersion": true,
    "entryPoints": ["src/index.ts"],
    "entryPointStrategy": "resolve"
  },

  "highlightLanguages": ["json", "typescript", "xml"],
  "readme": "README.md",

  "plugin": [
    "@sw-file-lib/typedoc-plugin-xml-schema",
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "out": "./docs/api",
  "docsRoot": "./docs",
  "indexFormat": "table"
}
