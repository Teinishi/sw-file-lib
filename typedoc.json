{
  "entryPoints": ["packages/core", "packages/geometry", "packages/three", "packages/xml"],
  "entryPointStrategy": "packages",
  "packageOptions": {
    "includeVersion": true,
    "entryPoints": ["src/index.ts"],
    "entryPointStrategy": "resolve"
  },

  "highlightLanguages": ["json", "typescript", "xml"],
  "readme": "README.md",

  "plugin": ["@clean-jsdoc-theme/typedoc"],
  "outputs": [{ "name": "clean-jsdoc-theme", "path": "dist-docs" }],

  "cleanJsdocTheme": {
    "siteName": "sw-file-lib"
  }
}
