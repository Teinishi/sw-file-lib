{
  "name": "sw-file-lib",
  "private": true,
  "description": "A monorepo containing libraries and tools for working with Stormworks files.",
  "homepage": "https://github.com/Teinishi/sw-file-lib#readme",
  "bugs": {
    "url": "https://github.com/Teinishi/sw-file-lib/issues"
  },
  "license": "MIT",
  "author": "Teinishi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teinishi/sw-file-lib.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --env-file-if-exists=.env.test.local ./node_modules/vitest/vitest.mjs",
    "typecheck": "tsc --noEmit",
    "check": "oxlint && oxfmt --check && tsc --noEmit && vitest run",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
