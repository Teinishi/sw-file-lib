{
  "name": "sw-file-lib",
  "private": true,
  "description": "TypeScript libraries for working with Stormworks files.",
  "homepage": "https://github.com/Teinishi/sw-file-lib#readme",
  "bugs": {
    "url": "https://github.com/Teinishi/sw-file-lib/issues"
  },
  "license": "MIT",
  "author": "Teinishi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teinishi/sw-file-lib.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "dev": "tsdown --watch",
    "dev:viewer": "pnpm --filter dev-viewer dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test:run",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "predocs": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@sw-file-lib/docs-plugins": "workspace:*",
    "@sw-file-lib/three": "workspace:*",
    "@sw-file-lib/xml": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.4",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "three": "^0.185.1",
    "ts-essentials": "^10.2.1",
    "tsdown": "^0.22.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "vitepress-plugin-group-icons": "^1.7.6"
  }
}
