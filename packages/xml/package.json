{
  "name": "@sw-file-lib/xml",
  "version": "0.1.0",
  "description": "TypeScript library for reading and writing Stormworks XML file formats.",
  "keywords": [],
  "license": "MIT",
  "author": "Teinishi",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./xml-schema": {
      "development": "./src/xml-schema/index.ts",
      "types": "./dist/xml-schema/index.d.mts",
      "import": "./dist/xml-schema/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit",
    "build": "tsdown",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@sw-file-lib/core": "workspace:*",
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@sw-file-lib/test-utils": "workspace:*"
  }
}
