{
  "name": "@sw-file-lib/core",
  "version": "0.2.0",
  "description": "TypeScript library for reading and writing Stormworks binary file formats.",
  "keywords": [],
  "homepage": "https://teinishi.github.io/sw-file-lib/",
  "license": "MIT",
  "author": "Teinishi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teinishi/sw-file-lib.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "sw-file-lib-dev": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./math": {
      "sw-file-lib-dev": "./src/math/index.ts",
      "types": "./dist/math/index.d.mts",
      "import": "./dist/math/index.mjs"
    },
    "./color": {
      "sw-file-lib-dev": "./src/color/index.ts",
      "types": "./dist/color/index.d.mts",
      "import": "./dist/color/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit",
    "build": "tsdown",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@sw-file-lib/test-utils": "workspace:*"
  }
}
