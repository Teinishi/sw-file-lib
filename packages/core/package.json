{
  "name": "@sw-file-lib/core",
  "version": "0.1.0",
  "description": "TypeScript library for reading and writing Stormworks binary file formats.",
  "keywords": [],
  "license": "MIT",
  "author": "Teinishi",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./math": {
      "development": "./src/math/index.ts",
      "import": "./dist/math/index.mjs",
      "types": "./dist/math/index.d.mts"
    },
    "./color": {
      "development": "./src/color/index.ts",
      "import": "./dist/color/index.mjs",
      "types": "./dist/color/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit",
    "build": "tsdown",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@sw-file-lib/test-utils": "workspace:*"
  }
}
