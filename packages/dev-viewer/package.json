{
  "name": "dev-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Development only 3D viewer for three.js development.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json "
  },
  "dependencies": {
    "@sw-file-lib/core": "workspace:*",
    "@sw-file-lib/geometry": "workspace:*",
    "@sw-file-lib/internal-utils": "workspace:*",
    "@sw-file-lib/three": "workspace:*",
    "@sw-file-lib/xml": "workspace:*",
    "three": "^0.185.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.10"
  }
}
